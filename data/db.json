  "songs": [
    {
      "id": "song-1",
      "title": "The Righteous Branch Shall Reign",
      "hymnNumber": "Hymn 01",
      "language": "English",
      "composer": "Righteous Branch Sanctuary Choir",
      "fileName": "hymn-01-righteous-branch.pdf",
      "fileSizeBytes": 1842,
      "lyricsExcerpt": "1. Behold the days of promise dawn,\nThe Branch of David rises bright;\nIn righteousness our King shall reign,\nAnd fill the earth with holy light.\n\nChorus:\nWorthy is the Lamb, the Living Vine,\nIn Him our weary souls abide;\nThe Lord our Righteousness is near,\nOur Shepherd, Saviour, King, and Guide.\n\n2. As living branches in the Vine,\nWe bear the fruit of love and grace;\nBuilt up a temple in the Lord,\nTo magnify His holy Name.",
      "uploadedAt": "2026-11-10T00:00:00.000Z"
    },
    {
      "id": "song-2",
      "title": "Christ in You, the Hope of Glory",
      "hymnNumber": "Hymn 02",
      "language": "English",
      "composer": "Righteous Branch Worship Fellowship",
      "fileName": "hymn-02-hope-of-glory.pdf",
      "fileSizeBytes": 1829,
      "lyricsExcerpt": "1. Hidden treasure of the ages,\nMystery revealed in grace;\nChrist within His living temple,\nShining in the secret place.\n\nChorus:\nChrist in us, the hope of glory,\nAnchor of the steadfast soul;\nEvery nation hears the story,\nJesus makes the broken whole.\n\n2. From the footstool to the throne room,\nWorshipping in spirit true;\nSealed unto the day of promise,\nAll things made forever new.",
      "uploadedAt": "2026-11-10T00:00:00.000Z"
    },
    {
      "id": "song-3",
      "title": "Yeshua Ha Messiah, Prince of Peace",
      "hymnNumber": "Hymn 03",
      "language": "English / Hebrew",
      "composer": "Sanctuary Praise Ensemble",
      "fileName": "hymn-03-yeshua-prince-of-peace.pdf",
      "fileSizeBytes": 1865,
      "lyricsExcerpt": "1. El Elyon, Most High Creator,\nAuthor of our steadfast faith;\nGuardian of the souls who trust Thee,\nStronger than the power of death.\n\nChorus:\nYeshua Ha Messiah, King of kings,\nTo Thy altar praise we bring;\nGreat Chief Shepherd of the flock,\nOur eternal Cornerstone and Rock.\n\n2. Holy High Priest, true and faithful,\nSoon returning for Thy bride;\nKeep our lamps forever burning,\nClose within Thy wounded side.",
      "uploadedAt": "2026-11-10T00:00:00.000Z"
    }
  ],
  "translationCache": {
    "063139eef785ced3d137684c779d7fda778f7f82": "இதோ, நாட்கள் வரும் என்று கர்த்தர் சொல்லுகிறார், நான் தாவீதுக்கு ஒரு நீதியுள்ள கிளையை எழுப்புவேன், அவன் ராஜாவாக ஆட்சிசெய்து, புத்திசாலித்தனமாக நடந்து, தேசத்தில் நியாயத்தையும் நீதியையும் நடத்துவான்.",
    "16e9b4c6deb374eec6cb7d1a44bc21016b0d9dd9": "அவருடைய நாட்களில் யூதா இரட்சிக்கப்படும், இஸ்ரவேல் சுகமாய்க் குடியிருக்கும். அவர் அழைக்கப்படும் அவருடைய பெயர் இதுதான்: யெகோவா எங்கள் நீதி."
  }
